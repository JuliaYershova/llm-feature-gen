# Byte‑compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
site/
*.egg-info/

# Environments & dependencies
# contains secrets; should never be committed
.env
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python tools and test caches
.pytest_cache/
.cache/
.tox/
.nox/
*.coverage
coverage.*
htmlcov/

# Jupyter Notebooks
.ipynb_checkpoints/

# IDEs
# PyCharm project settings
.idea/
# VS Code settings
.vscode/

# OS files
# macOS
.DS_Store
# Windows
Thumbs.db

# Local working documents (JMLR paper drafts, experiment plans)
paper/

# Local images/results (customize as needed)
# generated feature JSONs and other outputs
outputs/
# your local image dataset (if not meant to be tracked)
discover_images/

# Logs and temporary files
*.log
